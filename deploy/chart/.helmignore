# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Claude Code
.claude/
# Documentation source, not chart content
README.md.gotmpl
# Contributor-facing, not chart content
CONTRIBUTING.md
# Artifact Hub repo metadata - pushed as a separate OCI artifact, not chart content
artifacthub-repo.yml
# CI/CD
.github/
.gitlab-ci.yml
# Testing
tests/
ci/
# Chart tooling
tools/
.schema-drift-allow
# CI scanner config
.trivyignore
# Development
Taskfile.yml
Taskfile.yaml
.task/
