# Shared tool and base-image version pins - single source of truth.
# Loaded by Taskfile.yml via dotenv and consumed by CI workflows.

# Lint and security tooling
# renovate: datasource=github-releases depName=golangci/golangci-lint
GOLANGCILINT_VERSION=v2.8.0
# renovate: datasource=go depName=golang.org/x/vuln
GOVULNCHECK_VERSION=v1.4.0
# Not Renovate-managed: the checksum pin below must be recomputed by hand.
TYPOS_VERSION=1.44.0
# crate-ci/typos publishes no checksums; this is our own pin of the
# x86_64-unknown-linux-musl release asset. Recompute when bumping TYPOS_VERSION:
#   curl -sfLO <release asset> && shasum -a 256 typos-*.tar.gz
TYPOS_SHA256_LINUX_X86_64=1b788b7d764e2f20fe089487428a3944ed218d1fb6fcd8eac4230b5893a38779
# renovate: datasource=pypi depName=yamllint
YAMLLINT_VERSION=1.35.1
# Python lint deps chart-testing shells out to. Pinned for the same reason as
# everything else here: an unpinned `pip install` makes the chart gate resolve
# whatever PyPI serves that day.
YAMALE_VERSION=6.1.0
PYYAML_VERSION=6.0.3

# Task version installed by CI (local installs may differ)
# renovate: datasource=github-releases depName=go-task/task extractVersion=^v(?<version>.+)$
TASK_VERSION=3.49.1

# Trivy base image (aquasec/trivy) the adapter image is built FROM.
# Named like harbor-next's pin; must NOT be TRIVY_VERSION because dotenv exports
# these into every task's environment and the scanner itself reads TRIVY_VERSION
# (pkg/harbor/model.go), which would poison unit tests and `task run`.
# The docker datasource (not github-releases) so a bump PR only appears once
# the aquasec/trivy tag the Dockerfile is FROM actually exists.
# renovate: datasource=docker depName=aquasec/trivy
TRIVY_BASE_IMAGE_VERSION=0.72.0
# The trivy binary we build from this tag also carries CVE overrides; that list
# is per-module with a per-entry justification, so it lives in its own file
# rather than here: see trivy-cve-overrides.txt. Re-check it when bumping the
# version above.

# lprobe healthcheck binary (ghcr.io/fivexl/lprobe); same pin as harbor-next
# renovate: datasource=docker depName=ghcr.io/fivexl/lprobe
LPROBE_VERSION=0.1.9

# Helm chart toolchain (chart-ci.yml installs the same pins)
HELM_VERSION=v4.2.3
HELM_UNITTEST_VERSION=v1.1.2
HELM_DOCS_VERSION=1.14.2
CT_VERSION=3.14.0
KUBE_LINTER_VERSION=0.8.3
AH_VERSION=1.22.0
ORAS_VERSION=1.3.3
AJV_CLI_VERSION=5.0.0
NODE_IMAGE_VERSION=22
