---
extends: default

rules:
  line-length: disable
  truthy: disable

ignore: |
  # Go template syntax is not valid YAML. Everything else under helm/ - values,
  # Chart.yaml, ci/ and example/ scenarios - is linted here, and again by
  # `ct lint` with chart-testing's own config.
  /helm/harbor-scanner-trivy/templates/
  /helm/harbor-scanner-trivy/tests/__snapshot__/
